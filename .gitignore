# Exclude sibling projects
/ccx/
/code/
/dev c++/
/python/
/person/
/ai-backup-*/
/ai-db-backup-*/

# IDE and cache
.idea/
ai/.idea/
ai/__pycache__/
ai/**/__pycache__/

# Large model & runtime files
ai/models/tts/GPT-SoVITS-1007-cu128/
ai/models/asr/Qwen3-ASR-1.7B/

# Temp / generated files
ai/tts_outputs/
ai/last_recording.wav
