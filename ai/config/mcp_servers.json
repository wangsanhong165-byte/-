{
  "mcp_servers": {
    "time": {
      "command": "python",
      "args": [
        "-m",
        "mcp_server_time",
        "--local-timezone=Asia/Shanghai"
      ]
    },
    "ddg-search": {
      "command": "python",
      "args": [
        "-m",
        "duckduckgo_mcp_server.server"
      ],
      "env": {
        "DDG_SEARCH_BACKEND": "auto"
      }
    }
  }
}
