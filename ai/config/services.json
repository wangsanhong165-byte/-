{
  "_meta": {
    "description": "Canonical lifecycle service manifest",
    "priority": "manifest < user overrides < environment < CLI",
    "capabilities": {
      "text": {
        "display_name": "文本交流",
        "minimum_level": "TEXT_READY",
        "required_services": ["llm", "bridge"]
      },
      "voice": {
        "display_name": "语音交流",
        "minimum_level": "VOICE_READY",
        "required_services": ["asr", "tts"],
        "optional_services": ["gsvi"]
      }
    }
  },
  "gsvi": {
    "display_name": "语音模型", "category": "voice", "provider": "GPT-SoVITS", "startup_priority": 100,
    "host": "127.0.0.1", "port": 19205, "fallback_ports": [19305, 19405], "dynamic_port": true, "health": "/ready", "timeout": 180,
    "readiness": true, "profiles": ["backend", "electron", "full"], "failure_policy": "isolate",
    "env": {"BROWSER": "none", "PATH": "{python_dir};{PATH}", "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True", "NLTK_DATA": "{root}/models/tts/nltk_data"},
    "cwd": "models/tts/GPT-SoVITS-v2pro-20250604-nvidia50",
    "command": {
      "executable": "{python}",
      "script": "{root}/models/tts/GPT-SoVITS-v2pro-20250604-nvidia50/api_v2.py",
      "args": ["-a", "{host}", "-p", "{port}", "-c", "{root}/models/tts/GPT-SoVITS-v2pro-20250604-nvidia50/GPT_SoVITS/configs/tts_infer.yaml"]
    }
  },
  "tts": {
    "display_name": "语音合成", "category": "voice", "startup_priority": 110,
    "host": "127.0.0.1", "port": 19203, "fallback_ports": [19303, 19403], "dynamic_port": true, "health": "/health", "timeout": 120,
    "readiness": true, "depends_on": ["gsvi"], "profiles": ["backend", "electron", "full"], "failure_policy": "isolate",
    "command": {"module": "app.modules.tts.api", "args": ["--env-file", "{root}/config/.env", "--host", "{host}", "--port", "{port}"]},
    "warmup": {"url": "http://{host}:{port}/warmup", "body": "{}", "timeout": 180}
  },
  "asr": {
    "display_name": "语音识别", "category": "voice", "startup_priority": 120,
    "host": "127.0.0.1", "port": 19201, "fallback_ports": [19301, 19401], "dynamic_port": true, "health": "/health", "timeout": 120,
    "readiness": true, "depends_on": ["tts"], "profiles": ["backend", "electron", "full"], "failure_policy": "isolate",
    "env": {"ASR_MODEL_DIR": "{root}/models/asr/Qwen3-ASR-0.6B"},
    "command": {"module": "app.modules.asr.api", "args": ["--host", "{host}", "--port", "{port}"]}
  },
  "llm": {
    "display_name": "文本智能", "category": "text", "startup_priority": 10,
    "host": "127.0.0.1", "port": 19202, "fallback_ports": [19302, 19402], "dynamic_port": true, "health": "/health", "timeout": 30,
    "profiles": ["backend", "electron", "full"], "failure_policy": "isolate",
    "command": {"module": "app.modules.llm.api", "args": ["--env-file", "{root}/config/.env", "--host", "{host}", "--port", "{port}"]}
  },
  "bridge": {
    "display_name": "角色连接", "category": "text", "startup_priority": 30,
    "host": "127.0.0.1", "port": 19206, "fallback_ports": [19306, 19406], "dynamic_port": true, "health": null, "timeout": 90,
    "depends_on": ["llm"], "profiles": ["web", "backend", "electron", "full"],
    "command": {"module": "app.bridge.server", "args": ["--host", "{host}", "--port", "{port}"]}
  },
  "frontend": {
    "display_name": "开发界面", "category": "interface",
    "host": "127.0.0.1", "port": 5173, "fallback_ports": [19573, 20573], "dynamic_port": true, "health": null, "timeout": 15,
    "depends_on": ["bridge"], "profiles": ["full"], "cwd": "frontend",
    "command": {
      "executable": "node",
      "script": "{root}/frontend/node_modules/vite/bin/vite.js",
      "args": ["--host", "{host}", "--port", "{port}", "--strictPort"]
    }
  }
}
