{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Companion Runtime V3 Events",
  "protocolVersion": "3.0",
  "envelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "protocolVersion",
      "eventId",
      "eventType",
      "sessionId",
      "turnId",
      "sequence",
      "source",
      "timestamp",
      "payload"
    ],
    "properties": {
      "protocolVersion": {
        "const": "3.0"
      },
      "eventId": {
        "type": "string",
        "minLength": 1
      },
      "eventType": {
        "enum": [
          "asr.failed",
          "asr.result",
          "asr.started",
          "assistant.failed",
          "assistant.text.chunk",
          "assistant.text.completed",
          "assistant.text.started",
          "character.component",
          "character.control.requested",
          "character.expression",
          "character.intent",
          "character.motion",
          "character.snapshot",
          "character.suggestion",
          "character.suggestion.accepted",
          "character.suggestion.rejected",
          "configuration.updated",
          "management.failed",
          "management.requested",
          "management.result",
          "protocol.error",
          "runtime.degraded",
          "runtime.ready",
          "runtime.status",
          "service.status",
          "session.closed",
          "session.open",
          "session.opened",
          "session.ping",
          "session.pong",
          "telemetry.batch",
          "tool.failed",
          "tool.requested",
          "tool.result",
          "tool.started",
          "tts.audio",
          "tts.cancelled",
          "tts.completed",
          "tts.failed",
          "tts.started",
          "turn.cancelled",
          "turn.completed",
          "turn.failed",
          "turn.progress",
          "turn.started",
          "user.audio.cancelled",
          "user.audio.chunk",
          "user.audio.completed",
          "user.audio.started",
          "user.text",
          "user.visual"
        ]
      },
      "sessionId": {
        "type": "string",
        "minLength": 1
      },
      "turnId": {
        "type": [
          "string",
          "null"
        ]
      },
      "sequence": {
        "type": "integer",
        "minimum": 1
      },
      "source": {
        "enum": [
          "frontend",
          "runtime",
          "bridge",
          "lifecycle",
          "platform"
        ]
      },
      "timestamp": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "payload": {
        "type": "object"
      }
    }
  },
  "events": {
    "asr.failed": {
      "scope": "turn",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "FailurePayload",
        "type": "object"
      }
    },
    "asr.result": {
      "scope": "turn",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Language"
          }
        },
        "required": [
          "text"
        ],
        "title": "AsrResultPayload",
        "type": "object"
      }
    },
    "asr.started": {
      "scope": "turn",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Language"
          }
        },
        "title": "AsrStartedPayload",
        "type": "object"
      }
    },
    "assistant.failed": {
      "scope": "turn",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "FailurePayload",
        "type": "object"
      }
    },
    "assistant.text.chunk": {
      "scope": "turn",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "delta": {
            "title": "Delta",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "delta",
          "text"
        ],
        "title": "AssistantTextChunkPayload",
        "type": "object"
      }
    },
    "assistant.text.completed": {
      "scope": "turn",
      "payload": {
        "$defs": {
          "AssistantSegment": {
            "additionalProperties": false,
            "properties": {
              "text": {
                "title": "Text",
                "type": "string"
              },
              "emotion": {
                "title": "Emotion",
                "type": "string"
              },
              "behavior": {
                "title": "Behavior",
                "type": "string"
              }
            },
            "required": [
              "text",
              "emotion",
              "behavior"
            ],
            "title": "AssistantSegment",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "reasoning": {
            "default": "",
            "title": "Reasoning",
            "type": "string"
          },
          "segments": {
            "items": {
              "$ref": "#/$defs/AssistantSegment"
            },
            "title": "Segments",
            "type": "array"
          }
        },
        "required": [
          "text"
        ],
        "title": "AssistantTextCompletedPayload",
        "type": "object"
      }
    },
    "assistant.text.started": {
      "scope": "turn",
      "payload": {
        "additionalProperties": false,
        "properties": {},
        "title": "EmptyPayload",
        "type": "object"
      }
    },
    "character.component": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "displayName": {
            "default": "",
            "title": "Displayname",
            "type": "string"
          },
          "controller": {
            "default": "",
            "title": "Controller",
            "type": "string"
          },
          "priority": {
            "default": 0,
            "title": "Priority",
            "type": "integer"
          },
          "expression": {
            "default": "",
            "title": "Expression",
            "type": "string"
          },
          "paramIds": {
            "items": {
              "type": "string"
            },
            "title": "Paramids",
            "type": "array"
          }
        },
        "required": [
          "name",
          "enabled"
        ],
        "title": "CharacterComponentPayload",
        "type": "object"
      }
    },
    "character.control.requested": {
      "scope": "system",
      "payload": {
        "$defs": {
          "JsonValue": {}
        },
        "additionalProperties": false,
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Params",
            "type": "object"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "action",
          "requestId"
        ],
        "title": "CharacterControlRequestedPayload",
        "type": "object"
      }
    },
    "character.expression": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "intensity": {
            "default": 1.0,
            "maximum": 1,
            "minimum": 0,
            "title": "Intensity",
            "type": "number"
          },
          "controller": {
            "default": "",
            "title": "Controller",
            "type": "string"
          },
          "priority": {
            "default": 0,
            "title": "Priority",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "title": "CharacterExpressionPayload",
        "type": "object"
      }
    },
    "character.intent": {
      "scope": "turn",
      "payload": {
        "$defs": {
          "CharacterIntentSegmentPayload": {
            "additionalProperties": false,
            "properties": {
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Text"
              },
              "emotion": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Emotion"
              },
              "behavior": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Behavior"
              },
              "intensity": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Intensity"
              },
              "attention": {
                "anyOf": [
                  {
                    "enum": [
                      "user",
                      "screen",
                      "away",
                      "neutral"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Attention"
              },
              "energy": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Energy"
              },
              "durationMs": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Durationms"
              },
              "naturalVAD": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NaturalVadPayload"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "contextTags": {
                "items": {
                  "type": "string"
                },
                "title": "Contexttags",
                "type": "array"
              },
              "motionPlan": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/MotionPlanPayload"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "title": "CharacterIntentSegmentPayload",
            "type": "object"
          },
          "MotionPlanPayload": {
            "additionalProperties": false,
            "properties": {
              "durationMs": {
                "maximum": 8000,
                "minimum": 300,
                "title": "Durationms",
                "type": "integer"
              },
              "steps": {
                "items": {
                  "$ref": "#/$defs/MotionPlanStepPayload"
                },
                "maxItems": 3,
                "minItems": 1,
                "title": "Steps",
                "type": "array"
              }
            },
            "required": [
              "durationMs",
              "steps"
            ],
            "title": "MotionPlanPayload",
            "type": "object"
          },
          "MotionPlanStepPayload": {
            "additionalProperties": false,
            "properties": {
              "atMs": {
                "minimum": 0,
                "title": "Atms",
                "type": "integer"
              },
              "durationMs": {
                "maximum": 2500,
                "minimum": 120,
                "title": "Durationms",
                "type": "integer"
              },
              "primitive": {
                "enum": [
                  "nod",
                  "tilt_left",
                  "tilt_right",
                  "lean_forward",
                  "lean_back",
                  "sway",
                  "look_left",
                  "look_right",
                  "breathe",
                  "shrug"
                ],
                "title": "Primitive",
                "type": "string"
              },
              "intensity": {
                "maximum": 1,
                "minimum": 0,
                "title": "Intensity",
                "type": "number"
              }
            },
            "required": [
              "atMs",
              "durationMs",
              "primitive",
              "intensity"
            ],
            "title": "MotionPlanStepPayload",
            "type": "object"
          },
          "NaturalVadPayload": {
            "additionalProperties": false,
            "properties": {
              "valence": {
                "title": "Valence",
                "type": "number"
              },
              "arousal": {
                "title": "Arousal",
                "type": "number"
              },
              "dominance": {
                "title": "Dominance",
                "type": "number"
              }
            },
            "required": [
              "valence",
              "arousal",
              "dominance"
            ],
            "title": "NaturalVadPayload",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "emotion": {
            "title": "Emotion",
            "type": "string"
          },
          "behavior": {
            "title": "Behavior",
            "type": "string"
          },
          "intensity": {
            "default": 0.5,
            "maximum": 1,
            "minimum": 0,
            "title": "Intensity",
            "type": "number"
          },
          "attention": {
            "default": "user",
            "enum": [
              "user",
              "screen",
              "away",
              "neutral"
            ],
            "title": "Attention",
            "type": "string"
          },
          "energy": {
            "maximum": 1,
            "minimum": 0,
            "title": "Energy",
            "type": "number"
          },
          "durationMs": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Durationms"
          },
          "naturalVAD": {
            "anyOf": [
              {
                "$ref": "#/$defs/NaturalVadPayload"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "contextTags": {
            "items": {
              "type": "string"
            },
            "title": "Contexttags",
            "type": "array"
          },
          "motionPlan": {
            "anyOf": [
              {
                "$ref": "#/$defs/MotionPlanPayload"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "segments": {
            "items": {
              "$ref": "#/$defs/CharacterIntentSegmentPayload"
            },
            "title": "Segments",
            "type": "array"
          }
        },
        "required": [
          "emotion",
          "behavior",
          "energy"
        ],
        "title": "CharacterIntentPayload",
        "type": "object"
      }
    },
    "character.motion": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "controller": {
            "default": "",
            "title": "Controller",
            "type": "string"
          },
          "priority": {
            "default": 0,
            "title": "Priority",
            "type": "integer"
          },
          "loop": {
            "default": false,
            "title": "Loop",
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "title": "CharacterMotionPayload",
        "type": "object"
      }
    },
    "character.snapshot": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "components": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Components",
            "type": "object"
          },
          "expression": {
            "default": "",
            "title": "Expression",
            "type": "string"
          },
          "expressionIntensity": {
            "default": 0.0,
            "title": "Expressionintensity",
            "type": "number"
          },
          "motion": {
            "default": "",
            "title": "Motion",
            "type": "string"
          }
        },
        "required": [
          "components"
        ],
        "title": "CharacterSnapshotPayload",
        "type": "object"
      }
    },
    "character.suggestion": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "suggestionId": {
            "title": "Suggestionid",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "action": {
            "title": "Action",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "suggestionId",
          "target",
          "name",
          "action",
          "reason"
        ],
        "title": "CharacterSuggestionPayload",
        "type": "object"
      }
    },
    "character.suggestion.accepted": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "suggestionId": {
            "title": "Suggestionid",
            "type": "string"
          }
        },
        "required": [
          "suggestionId"
        ],
        "title": "CharacterSuggestionAcceptedPayload",
        "type": "object"
      }
    },
    "character.suggestion.rejected": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "suggestionId": {
            "title": "Suggestionid",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "suggestionId"
        ],
        "title": "CharacterSuggestionRejectedPayload",
        "type": "object"
      }
    },
    "configuration.updated": {
      "scope": "system",
      "payload": {
        "$defs": {
          "JsonValue": {}
        },
        "additionalProperties": false,
        "properties": {
          "config": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Config",
            "type": "object"
          }
        },
        "required": [
          "config"
        ],
        "title": "ConfigurationUpdatedPayload",
        "type": "object"
      }
    },
    "management.failed": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "action": {
            "title": "Action",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "action",
          "code",
          "message"
        ],
        "title": "ManagementFailedPayload",
        "type": "object"
      }
    },
    "management.requested": {
      "scope": "system",
      "payload": {
        "$defs": {
          "JsonValue": {}
        },
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "action": {
            "title": "Action",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "requestId",
          "action"
        ],
        "title": "ManagementRequestedPayload",
        "type": "object"
      }
    },
    "management.result": {
      "scope": "system",
      "payload": {
        "$defs": {
          "JsonValue": {}
        },
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "action": {
            "title": "Action",
            "type": "string"
          },
          "data": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Data",
            "type": "object"
          }
        },
        "required": [
          "requestId",
          "action",
          "data"
        ],
        "title": "ManagementResultPayload",
        "type": "object"
      }
    },
    "protocol.error": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Requestid"
          },
          "offendingEventId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Offendingeventid"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ProtocolErrorPayload",
        "type": "object"
      }
    },
    "runtime.degraded": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "services": {
            "items": {
              "type": "string"
            },
            "title": "Services",
            "type": "array"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "RuntimeDegradedPayload",
        "type": "object"
      }
    },
    "runtime.ready": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "services": {
            "items": {
              "type": "string"
            },
            "title": "Services",
            "type": "array"
          }
        },
        "title": "RuntimeReadyPayload",
        "type": "object"
      }
    },
    "runtime.status": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "state": {
            "title": "State",
            "type": "string"
          },
          "message": {
            "default": "",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "RuntimeStatusPayload",
        "type": "object"
      }
    },
    "service.status": {
      "scope": "system",
      "payload": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "state": {
            "enum": [
              "starting",
              "ready",
              "degraded",
              "failed",
